  <step>
    <name>offer_req</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>airline-dv</connection>
    <sql>SELECT
    o.hk_offer,
    s.departure_time,
    s.arrival_time,
    CASE
        WHEN s.stops IN ('non-stop','nonstop','none','zero','0') THEN 0
        WHEN s.stops IN ('one','1','1 stop','1_stop') THEN 1
        WHEN s.stops IN ('two','2','2 stop','2_stop','2 stops') THEN 2
        ELSE 3
    END AS stops,
    s.class,
    s.duration,
    ROUND(s.duration * 60) AS duration_min,
    s.days_left,
    s.price,
    NOW() AS load_dts,
    'stg_flights_offers_raw' AS record_source
FROM stg.flights_offers_raw s
JOIN rdv.hub_offer o ON o.offer_bk = s.idx::text;
</sql>
